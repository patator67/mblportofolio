---
// Assets
import { Image } from "astro:assets";
import imgStarburst from "@/images/work/starburstproject.jpeg";
import imgAirbus from "@/images/work/airbusproject.jpg";
import imgAco from "@/images/work/acoproject.jpg";
import logoStarburst from "@/images/logos/starburst.png";
import logoAirbus from "@/images/logos/airbus.png";
import logoAco from "@/images/logos/aco.png";
// Data
import { workEntries } from "@/data/work";
// Fundations
import Wrapper from "@/components/fundations/containers/Wrapper.astro";

const imageMap: Record<string, ImageMetadata> = {
  starburst: imgStarburst,
  "airbus-helicopters": imgAirbus,
  "aco-le-mans": imgAco,
};

const logoMap: Record<string, ImageMetadata> = {
  starburst: logoStarburst,
  "airbus-helicopters": logoAirbus,
  "aco-le-mans": logoAco,
};

const logoWidth: Record<string, number> = {
  starburst: 560,
  "airbus-helicopters": 560,
  "aco-le-mans": 120,
};

const logoHeight: Record<string, number> = {
  starburst: 104,
  "airbus-helicopters": 104,
  "aco-le-mans": 120,
};

const logoClass: Record<string, string> = {
  starburst: "object-contain object-center brightness-0 invert h-10 w-auto max-w-[275px]",
  "airbus-helicopters": "object-contain object-center brightness-0 invert h-8 w-auto max-w-[200px]",
  "aco-le-mans": "object-contain object-center brightness-0 invert h-24 w-auto max-w-[96px]",
};
---

<section class="scroll-mt-20" id="work">
  <!-- Apple-style section header -->
  <Wrapper variant="standard" class="pt-24 pb-6">
    <p class="text-xs tracking-widest uppercase text-base-400 dark:text-base-500 mb-3">Experience</p>
    <h2 class="text-[clamp(2.5rem,7vw,5.5rem)] font-bold tracking-tighter text-base-900 dark:text-white leading-none">
      Work.
    </h2>
  </Wrapper>

  <!-- Responsive tile grid: 1 col → 3 col -->
  <Wrapper variant="standard" class="grid grid-cols-1 lg:grid-cols-3 gap-3 pb-24">
    {workEntries.map((entry) => (
      <a
        href={"/work/" + entry.slug}
        data-modal-open={"work-" + entry.slug}
        data-modal-label={entry.company}
        class="apple-tile stagger-fade flex flex-col group"
        style="min-height:500px"
      >
        <div class="p-8 flex flex-col flex-1">
          <!-- Logo area: fixed height so text always starts at same level -->
          <div class="flex justify-center items-center h-24 w-full mb-6">
            <span
              onclick="event.preventDefault(); event.stopPropagation(); window.open(this.dataset.href, '_blank', 'noopener,noreferrer')"
              data-href={entry.website}
              role="link"
              tabindex="0"
              class="tile-logo flex justify-center items-center cursor-pointer"
            >
              <Image
                src={logoMap[entry.slug]}
                alt={entry.company + " logo"}
                width={logoWidth[entry.slug]}
                height={logoHeight[entry.slug]}
                class={logoClass[entry.slug]}
              />
            </span>
          </div>
          <!-- Category -->
          <p class="text-xs tracking-widest uppercase font-semibold text-base-400 dark:text-base-500 mb-2">{entry.category}</p>
          <!-- Description -->
          <p class="text-base text-base-300 dark:text-base-400 leading-relaxed flex-1">{entry.description}</p>
          <!-- Period + expand indicator -->
          <div class="flex items-center justify-between mt-6">
            <p class="text-xs text-base-600 dark:text-base-500">{entry.period}</p>
            <span
              class="w-8 h-8 rounded-full border border-base-700 dark:border-base-600 group-hover:border-base-400 dark:group-hover:border-base-300
                     flex items-center justify-center
                     text-base-600 dark:text-base-500 group-hover:text-base-200 dark:group-hover:text-base-200
                     transition-all duration-300"
              aria-hidden="true"
            >
              <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M6 1V11M1 6H11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              </svg>
            </span>
          </div>
        </div>
        <!-- Cover image -->
        <div class="apple-tile-inner mx-4 mb-4">
          <Image
            src={imageMap[entry.slug]}
            alt={entry.company + " — " + entry.location}
            width={800}
            height={450}
            loading="lazy"
            decoding="async"
            class="w-full object-cover aspect-video"
          />
        </div>
      </a>
    ))}
  </Wrapper>
</section>
