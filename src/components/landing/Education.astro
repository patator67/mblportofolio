---
// Foundations
import { Image } from "astro:assets";
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
// Data
import { educationEntries } from "@/data/education";
// Logos
import logoBocconi from "@/images/logos/bocconi.png";
import logoImperial from "@/images/logos/imperial.png";
import logoSupaero from "@/images/logos/supaero.png";

// key → logo image
const logoMap: Record<string, ImageMetadata> = {
  bocconi: logoBocconi,
  imperial: logoImperial,
  supaero: logoSupaero,
};

// Bocconi 1903×398 (4.78:1) | Imperial 12900×1417 (9.1:1) | SUPAERO 1821×1102 (1.65:1)
// Base sizes × scale: Bocconi h-10×0.9=h-9, Imperial h-8×0.95≈h-8(kept), SUPAERO h-12×1.2=h-14
const logoWidth: Record<string, number> = { bocconi: 344, imperial: 519, supaero: 262 };
const logoHeight: Record<string, number> = { bocconi: 72, imperial: 57, supaero: 158 };
const logoClass: Record<string, string> = {
  bocconi:  "object-contain object-left brightness-0 invert-0 dark:invert h-9 w-auto max-w-[172px]",
  imperial: "object-contain object-left brightness-0 invert-0 dark:invert h-[30px] w-auto max-w-[210px]",
  supaero:  "object-contain object-left brightness-0 invert-0 dark:invert h-14 w-auto max-w-[96px]",
};
---

<section class="scroll-mt-20" id="education">
  <Wrapper variant="standard" class="py-12 lg:py-16">
    <p class="text-xs tracking-widest uppercase text-base-400 dark:text-base-500 mb-3">Formation — Ongoing</p>
    <h2 class="text-[clamp(1.75rem,5vw,3.5rem)] font-bold tracking-tighter text-base-900 dark:text-white leading-none mb-2">
      Education.
    </h2>
    <div class="h-px bg-base-900 dark:bg-base-100 mb-0"></div>

    <div class="flex flex-col">
      {
        educationEntries.map((item) => (
          <div class="hover-row border-b border-base-200 dark:border-base-800 -mx-6 lg:-mx-12 px-6 lg:px-12">
            <!-- Always-visible header row -->
            <div class="py-8 lg:py-10 grid grid-cols-1 gap-3 lg:grid-cols-12 items-center">
              <Text
                tag="p"
                variant="textXS"
                class="text-base-400 dark:text-base-500 uppercase tracking-widest lg:col-span-2"
              >
                {item.period}
              </Text>

              <div class="lg:col-span-3">
                <a
                  href={item.website}
                  target="_blank"
                  rel="noopener noreferrer"
                  onclick="event.stopPropagation()"
                  class="inline-flex items-center opacity-80 hover:opacity-100 transition-opacity duration-150 mb-2"
                >
                  <Image
                    src={logoMap[item.key]}
                    alt={item.title + " logo"}
                    width={logoWidth[item.key]}
                    height={logoHeight[item.key]}
                    class={logoClass[item.key]}
                  />
                </a>
                <Text tag="p" variant="textXS" class="text-base-400 dark:text-base-500 mt-0.5">
                  {item.location}
                </Text>
              </div>

              <Text
                tag="p"
                variant="textSM"
                class="text-base-500 dark:text-base-400 lg:col-span-5 lg:col-start-6"
              >
                {item.degree}
              </Text>

              <div class="hidden lg:flex lg:col-span-2 lg:col-start-11 lg:justify-end items-center gap-1">
                <Text tag="p" variant="textXS" class="text-base-300 dark:text-base-600 uppercase tracking-widest">
                  Hover
                </Text>
                <svg class="size-3 text-base-300 dark:text-base-600 transition-transform duration-300 ease-spring group-hover:rotate-90" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M4 2l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </div>
            </div>

            <!-- Hover-revealed expanded content -->
            <div class="reveal-panel">
              <div class="reveal-inner">
                <div class="reveal-content pb-10 lg:pb-14 grid grid-cols-1 lg:grid-cols-12 gap-8">
                  <div class="lg:col-span-5 lg:col-start-3">
                    <Text tag="p" variant="textXS" class="text-base-400 dark:text-base-500 uppercase tracking-widest mb-4">
                      Courses
                    </Text>
                    <ul class="flex flex-col gap-1.5">
                      {item.courses.map((course) => (
                        <li>
                          <Text tag="p" variant="textSM" class="text-base-600 dark:text-base-300">
                            {course}
                          </Text>
                        </li>
                      ))}
                    </ul>
                  </div>

                  <div class="lg:col-span-4 lg:col-start-9">
                    <Text tag="p" variant="textXS" class="text-base-400 dark:text-base-500 uppercase tracking-widest mb-4">
                      Projects
                    </Text>
                    <div class="flex flex-col gap-5">
                      {item.projects.map((project) => (
                        <div>
                          <Text tag="p" variant="textSM" class="text-base-900 dark:text-white font-semibold mb-1">
                            {project.title}
                          </Text>
                          <Text tag="p" variant="textSM" class="text-base-500 dark:text-base-400">
                            {project.description}
                          </Text>
                        </div>
                      ))}
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </Wrapper>
</section>
