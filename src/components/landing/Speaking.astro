---
// Foundations
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
// Data
import { infoSections } from "@/data/skills";
---

<section class="scroll-mt-20" id="info">
  <Wrapper variant="standard" class="py-12 lg:py-16">
    <p class="text-xs tracking-widest uppercase text-base-400 dark:text-base-500 mb-3">Knowledge & Interests</p>
    <h2 class="text-[clamp(1.75rem,5vw,3.5rem)] font-bold tracking-tighter text-base-900 dark:text-white leading-none mb-4">
      Info.
    </h2>
    <div class="h-px bg-base-900 dark:bg-base-100 mb-8"></div>

    <div class="flex flex-col gap-12 lg:gap-16">
      {
        infoSections.map((section) => (
          <div>
            <!-- Section category header -->
            <p class="text-xs tracking-widest uppercase font-semibold text-base-400 dark:text-base-500 mb-6">
              {section.category}
            </p>

            <!-- Section items -->
            <div class="flex flex-col gap-6">
              {
                section.items.map((item) => (
                  <div class="grid grid-cols-1 lg:grid-cols-12 gap-3 lg:gap-6">
                    <!-- Title (left side) -->
                    <div class="lg:col-span-4">
                      <p class="text-base font-semibold text-base-900 dark:text-white leading-snug">
                        {item.title}
                      </p>
                    </div>
                    <!-- Description (right side) -->
                    <div class="lg:col-span-8">
                      <p class="text-sm text-base-500 dark:text-base-400 leading-relaxed">
                        {item.description}
                      </p>
                    </div>
                  </div>
                ))
              }
            </div>

            <!-- Divider between sections (except last) -->
            {section !== infoSections[infoSections.length - 1] && (
              <div class="h-px bg-base-200 dark:bg-base-800 mt-8 lg:mt-10"></div>
            )}
          </div>
        ))
      }
    </div>
  </Wrapper>
</section>
