---
// Assets
import { Image } from "astro:assets";
import imgUav from "@/images/projects/uavproject.jpeg";
import imgPrice from "@/images/projects/pricepredictionproject.jpg";
import imgAvd from "@/images/projects/vehicledesignproject.jpeg";
import imgPrint from "@/images/projects/3dprintingproject.jpg";
import imgLutlab from "@/images/projects/lutlabproject.png";
import imgDiy from "@/images/projects/diyproject.png";
// Data
import { projects } from "@/data/projects";
// Fundations
import Wrapper from "@/components/fundations/containers/Wrapper.astro";

const imageMap: Record<string, ImageMetadata> = {
  "uav-coastal-surveillance": imgUav,
  "ai-ticket-forecasting": imgPrice,
  "avd-project": imgAvd,
  "3d-printing": imgPrint,
  "lutlab": imgLutlab,
  "diy-projects": imgDiy,
};

const imageAltMap: Record<string, string> = {
  "uav-coastal-surveillance": "UAV coastal surveillance group design project.",
  "ai-ticket-forecasting": "AI ticket price forecasting model.",
  "avd-project": "Advanced Vehicle Design project.",
  "3d-printing": "3D printing personal projects.",
  "lutlab": "LutLab film simulation software.",
  "diy-projects": "DIY projects collection.",
};
---

<section class="scroll-mt-20" id="projects">
  <!-- Apple-style section header -->
  <Wrapper variant="standard" class="pt-16 lg:pt-20 pb-4 lg:pb-6">
    <p class="text-xs tracking-widest uppercase text-base-400 dark:text-base-500 mb-3">Featured Work</p>
    <h2 class="text-[clamp(1.75rem,5vw,3.5rem)] font-bold tracking-tighter text-base-900 dark:text-white leading-none">
      Projects.
    </h2>
  </Wrapper>

  <!-- Responsive tile grid: 1 col → 2 col → 3 col -->
  <Wrapper variant="standard" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3 pb-12 lg:pb-16">
    {projects.map((project) => (
      <a
        href={"/projects/" + project.slug}
        data-modal-open={"project-" + project.slug}
        data-modal-label={project.title}
        class="apple-tile stagger-fade flex flex-col group"
        style="min-height:460px"
      >
        <div class="p-7 flex flex-col flex-1">
          <p class="text-xs tracking-widest uppercase font-semibold text-base-400 dark:text-base-500 mb-2">{project.category}</p>
          <h3 class="text-2xl lg:text-3xl font-bold leading-tight tracking-tight mt-1 text-base-900 dark:text-white">{project.title}</h3>
          <p class="text-sm leading-relaxed mt-3 flex-1 text-base-300 dark:text-base-400">{project.description}</p>
          <!-- Year + expand indicator -->
          <div class="flex items-center justify-between mt-4">
            <p class="text-xs font-medium text-base-600 dark:text-base-500">{project.year}</p>
            <span
              class="w-8 h-8 rounded-full border border-base-700 dark:border-base-600 group-hover:border-base-400 dark:group-hover:border-base-300
                     flex items-center justify-center
                     text-base-600 dark:text-base-500 group-hover:text-base-200 dark:group-hover:text-base-200
                     transition-all duration-300"
              aria-hidden="true"
            >
              <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M6 1V11M1 6H11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              </svg>
            </span>
          </div>
        </div>
        <div class="apple-tile-inner mx-4 mb-4">
          <Image
            width={600}
            height={340}
            src={imageMap[project.slug]}
            alt={imageAltMap[project.slug]}
            loading="lazy"
            decoding="async"
            class="w-full object-cover aspect-video"
          />
        </div>
      </a>
    ))}
  </Wrapper>
</section>
