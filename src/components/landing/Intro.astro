---
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
---

<section class="relative bg-white dark:bg-base-950 overflow-hidden">

  <Wrapper variant="standard" class="relative z-10 pt-28 lg:pt-40 pb-24 lg:pb-36">

    <!-- Tiny top row -->
    <div class="stagger-fade flex items-center justify-between mb-12 lg:mb-16">
      <span class="text-[9px] tracking-[0.35em] uppercase text-white/20">Marius Borsu Lefevre</span>
      <span class="text-[9px] tracking-[0.35em] uppercase text-white/20">2026</span>
    </div>

    <!-- ── Main composed block ─────────────────────────────── -->
    <!-- Crosses live at this container's four corners         -->
    <div class="stagger-fade relative grid grid-cols-1 lg:grid-cols-[5fr_7fr] grid-rows-[auto_auto] gap-3">

      <!-- Corner crosses pinned to the block's own corners -->
      <span class="block-cross" style="top:-32px;    left:-32px;"></span>
      <span class="block-cross" style="top:-32px;    right:-32px;"></span>
      <span class="block-cross" style="bottom:-32px; left:-32px;"></span>
      <span class="block-cross" style="bottom:-32px; right:-32px;"></span>

      <!-- ① Name — top-left -->
      <div class="bg-base-800 dark:bg-base-800 rounded-[4px] px-10 pt-10 pb-8 lg:px-12 lg:pt-12 lg:pb-10">
        <h1 class="text-[clamp(2.2rem,4.5vw,4.5rem)] font-semibold tracking-[-0.02em] leading-[0.88] text-white dark:text-white">
          Marius<br />Borsu<br />Lefevre
        </h1>
      </div>

      <!-- ② Bio — top-right -->
      <div class="bg-base-800 dark:bg-base-800 px-10 py-10 lg:px-12 lg:py-12">
        <p class="text-[9px] tracking-[0.35em] uppercase text-base-600 dark:text-base-600 mb-6">About</p>
        <p class="text-[1.05rem] lg:text-[1.15rem] text-base-500 dark:text-base-400 leading-[1.9] font-light tracking-[-0.005em]">
          Aerospace engineer with a double degree from ISAE&#8209;Supaero and Imperial College London.
          I build at the edge of deep tech, product design, and venture &mdash; from UAV systems and
          AI models to startups and investment strategy. Always learning, always iterating.<span class="intro-cursor ml-px">&#9612;</span>
        </p>
      </div>

      <!-- ③ Portfolio + arrow — bottom-left -->
      <div class="bg-base-800 dark:bg-base-800 px-10 pt-8 pb-8 lg:px-12 lg:pt-10 lg:pb-10 flex flex-col justify-between gap-10">
        <p class="text-[9px] tracking-[0.35em] uppercase text-base-600 dark:text-base-600">Portfolio</p>
        <!-- Down arrow -->
        <svg width="28" height="28" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg" class="text-base-500 dark:text-base-600">
          <path d="M14 4V24M14 24L5 15M14 24L23 15" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </div>

      <!-- ④ Education — bottom-right -->
      <div class="bg-base-800 dark:bg-base-800 px-10 pt-8 pb-8 lg:px-12 lg:pt-10 lg:pb-10">
        <p class="text-[9px] tracking-[0.35em] uppercase text-base-600 dark:text-base-600 mb-8">Education</p>
        <div class="flex flex-col gap-6">
          <div>
            <p class="text-sm font-semibold text-base-100 dark:text-base-100 leading-snug">ISAE-Supaero</p>
            <p class="text-xs text-base-500 dark:text-base-600 mt-0.5 tracking-wide">MEng Aerospace Engineering &middot; 2022–2025</p>
          </div>
          <div>
            <p class="text-sm font-semibold text-base-100 dark:text-base-100 leading-snug">Imperial College London</p>
            <p class="text-xs text-base-500 dark:text-base-600 mt-0.5 tracking-wide">MSc Innovation &amp; Technology Management &middot; 2025–2026</p>
          </div>
          <div>
            <p class="text-sm font-semibold text-base-100 dark:text-base-100 leading-snug">Bocconi University</p>
            <p class="text-xs text-base-500 dark:text-base-600 mt-0.5 tracking-wide">Exchange — Finance &amp; Strategy &middot; 2024</p>
          </div>
        </div>
      </div>

    </div>

  </Wrapper>
</section>

<style>
  .block-cross {
    position: absolute;
    display: block;
    width: 0;
    height: 0;
    z-index: 10;
  }
  .block-cross::before,
  .block-cross::after {
    content: '';
    position: absolute;
    background: #ffffff;
    opacity: 0.2;
    top: 0;
    left: 0;
    transform: translate(-50%, -50%);
  }
  .block-cross::before { width: 40px; height: 1px; }
  .block-cross::after  { width: 1px;  height: 40px; }

  @keyframes intro-blink {
    0%, 100% { opacity: 1; }
    50%       { opacity: 0; }
  }
  .intro-cursor {
    color: rgba(255, 255, 255, 0.15);
    animation: intro-blink 1.1s step-start infinite;
  }
</style>
