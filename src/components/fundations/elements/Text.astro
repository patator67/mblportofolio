---
export interface Props {
  tag?:
    | "a"
    | "p"
    | "em"
    | "span"
    | "small"
    | "strong"
    | "blockquote"
    | "h1"
    | "h2"
    | "h3"
    | "h4"
    | "h5"
    | "h6"; // Defines allowed HTML tags
  id?: string; // Optional 'id' attribute
  rel?: string; // Optional rel attribute for anchor tags
  style?: string; // Specifies inline styles
  target?: string; // Optional target attribute for links
  href?: string; // Optional 'href' attribute for anchor tags
  title?: string; // Optional title attribute for anchor tags
  variant?: string; // Specifies the style variant of the text
  class?: string; // Optional prop for additional custom classes
  ariaLabel?: string; // Optional aria-label attribute for anchor tags
}
// Define text styles for each variant
const textStyles: Record<string, string> = {
  /* Swiss display scale — tight tracking, bold weight expected from caller */
  display6XL: "text-[clamp(4rem,14vw,14rem)] leading-[0.9] tracking-tight",
  display5XL: "text-[clamp(3.5rem,11vw,11rem)] leading-[0.9] tracking-tight",
  display4XL: "text-[clamp(3rem,9vw,9rem)]   leading-[0.9] tracking-tight",
  display3XL: "text-[clamp(2.5rem,7vw,7rem)]  leading-[0.9] tracking-tight",
  display2XL: "text-[clamp(2rem,5.5vw,5.5rem)] leading-[0.95] tracking-tight",
  displayXL:  "text-[clamp(1.75rem,4.5vw,4.5rem)] leading-none tracking-tight",
  displayLG:  "text-[clamp(1.5rem,3.5vw,3.5rem)] leading-none tracking-tight",
  displayMD:  "text-[clamp(1.25rem,2.5vw,2.5rem)] leading-tight tracking-tight",
  displaySM:  "text-[clamp(1.125rem,2vw,2rem)]  leading-tight tracking-tight",
  displayXS:  "text-[clamp(1rem,1.5vw,1.5rem)]  leading-tight",
  /* Body scale */
  textXL:   "text-xl leading-relaxed",
  textLG:   "text-lg leading-relaxed",
  textBase: "text-base leading-relaxed",
  textSM:   "text-sm leading-relaxed",
  textXS:   "text-xs leading-normal",
};
// Destructure props with default values
const {
  tag: Tag = "p", // Defaults to paragraph tag
  class: className = "", // No additional classes by default
  variant = "textBase", // Defaults to textBase style variant
  ...rest // Collect remaining props
} = Astro.props;
// Get the base classes for the specified variant
const baseClasses = textStyles[variant] || textStyles.textBase; // Fallback to textBase if variant not found
// Combine base classes with any additional custom classes
const combinedClasses = `${baseClasses} ${className}`.trim();
---

<Tag class={combinedClasses} {...rest}>
  <slot name="left-icon" />
  <slot />
  <slot name="right-icon" />
</Tag>
