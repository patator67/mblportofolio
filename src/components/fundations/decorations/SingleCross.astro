---
// Decorative separator with left and right crosses and connecting line
---

<div class="flex items-center justify-center gap-12 py-12 lg:py-14 px-6">
  <span class="side-cross"></span>
  <div class="flex-1 h-px bg-white/15 max-w-2xl"></div>
  <span class="side-cross"></span>
</div>

<style>
  .side-cross {
    position: relative;
    display: block;
    width: 0;
    height: 0;
    flex-shrink: 0;
  }
  .side-cross::before,
  .side-cross::after {
    content: '';
    position: absolute;
    background: #ffffff;
    opacity: 0.15;
    top: 0;
    left: 0;
    transform: translate(-50%, -50%);
  }
  .side-cross::before { width: 40px; height: 1px; }
  .side-cross::after  { width: 1px;  height: 40px; }
</style>
