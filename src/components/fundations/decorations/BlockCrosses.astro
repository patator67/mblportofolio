---
// Reusable corner crosses for section headers
---

<div class="relative">
  <!-- Corner crosses pinned to the container's own corners -->
  <span class="block-cross" style="top:-32px;    left:-32px;"></span>
  <span class="block-cross" style="top:-32px;    right:-32px;"></span>
  <span class="block-cross" style="bottom:-32px; left:-32px;"></span>
  <span class="block-cross" style="bottom:-32px; right:-32px;"></span>
</div>

<style>
  .block-cross {
    position: absolute;
    display: block;
    width: 0;
    height: 0;
    z-index: 10;
  }
  .block-cross::before,
  .block-cross::after {
    content: '';
    position: absolute;
    background: #ffffff;
    opacity: 0.15;
    top: 0;
    left: 0;
    transform: translate(-50%, -50%);
  }
  .block-cross::before { width: 48px; height: 1px; }
  .block-cross::after  { width: 1px;  height: 48px; }
</style>
