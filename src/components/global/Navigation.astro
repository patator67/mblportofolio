---
// Assets
import Logo from "@/components/assets/Logo.astro";
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Button from "@/components/fundations/elements/Button.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";

const links = [
  { href: "#work", text: "Work" },
  { href: "#projects", text: "Projects" },
  { href: "#education", text: "Education" },
  { href: "#speaking", text: "Info" },
];
---

<nav class="bg-white dark:bg-base-950 border-b border-base-200 dark:border-base-800 fixed top-0 z-10 w-full">
  <Wrapper variant="standard" class="py-3">
    <div class="grid grid-cols-2 lg:grid-cols-4 items-center">
      <a href="/" class="flex">
        <Logo class="text-base-900 dark:text-white text-xs tracking-tight uppercase font-bold" />
      </a>
      <Text
        tag="p"
        variant="textXS"
        class="text-base-500 dark:text-base-400 tracking-tight hidden lg:block"
      >
        Paris — Milan — London
      </Text>
      <div class="hidden lg:flex gap-8 items-center">
        {
          links.map((link) => (
            <a
              href={link.href}
              class="text-base-500 dark:text-base-400 text-xs tracking-tight uppercase hover:text-base-900 dark:hover:text-white transition-colors duration-150"
            >
              {link.text}
            </a>
          ))
        }
      </div>
      <a
        href="mailto:mariusborsu@hotmail.fr"
        class="text-base-900 dark:text-white text-xs tracking-tight uppercase font-bold ml-auto hover:text-base-500 transition-colors duration-150"
      >
        Contact
      </a>
    </div>
  </Wrapper>
</nav>
